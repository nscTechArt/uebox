# 本机开发环境变量模板。真实 .env* 不进入版本库或安装包。
# 正常使用时请在偏好设置中填写自己的模型凭据，由系统安全存储保存。
# 不要把开发者的密钥写进 .env.production。

HTTP_AUTH_TOKEN=
JINA_API_KEY=
DASHSCOPE_API_KEY=
USE_GEMINI_NATIVE=
VITE_APP_ENV=

# 官网下载源（scripts/release-dl.mjs 用）。只有发版的人需要，装应用的人用不到。
# R2_PUBLIC_BASE 是对外的下载域名，写进 manifest.json 里给官网显示。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=https://dl.uebox.ai

# 国内镜像（可选，任意 S3 兼容存储，如雨云 / 阿里云 OSS / 腾讯云 COS）。
# 填了就和 R2 传一模一样的一份，官网和盒子内检查更新会自动挑快的那个。
# ENDPOINT 是存储的 S3 API 地址，PUBLIC_BASE 是绑在桶上的对外下载域名。
MIRROR_S3_ENDPOINT=
MIRROR_S3_REGION=
MIRROR_S3_BUCKET=
MIRROR_S3_ACCESS_KEY_ID=
MIRROR_S3_SECRET_ACCESS_KEY=
MIRROR_PUBLIC_BASE=
