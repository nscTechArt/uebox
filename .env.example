# 本机开发环境变量模板。真实 .env* 不进入版本库或安装包。
# 正常使用时请在偏好设置中填写自己的模型凭据，由系统安全存储保存。
# 不要把开发者的密钥写进 .env.production。

HTTP_AUTH_TOKEN=
JINA_API_KEY=
DASHSCOPE_API_KEY=
USE_GEMINI_NATIVE=
VITE_APP_ENV=

# 官网下载源（scripts/release-dl.mjs 用）。只有发版的人需要，装应用的人用不到。
# R2_PUBLIC_BASE 是对外的下载域名，写进 manifest.json 里给官网显示。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=https://dl.uebox.ai
